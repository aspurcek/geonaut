    "Başkentler kategorisinin 3 turunu da (Tur 1, Tur 2, Tur 3) tamamladığında bu kupayı kazanırsın." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
