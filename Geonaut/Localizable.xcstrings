    "Oynamadığın %lld gün için seri koruyucu kullanıldı. %lld günlük serin devam ediyor. Bugün oynamayı unutma!" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für deine verpassten Tage (%lld) wurde Serienschutz eingesetzt. Deine Serie von %lld Tagen läuft weiter. Vergiss nicht, heute zu spielen!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A streak freeze covered the days you missed (%lld). Your %lld-day streak continues. Don't forget to play today!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usó protección de racha por los días que no jugaste (%lld). Tu racha de %lld días continúa. ¡No olvides jugar hoy!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynamadığın %lld gün için seri koruyucu kullanıldı. %lld günlük serin devam ediyor. Bugün oynamayı unutma!"
          }
        }
      }
    },
    "Seri koruyucun varsa oynamadığın gün için kendiliğinden kullanılır ve serin bozulmaz. Günlük görevleri bitirerek kazanırsın." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Serienschutz hast, wird er an einem Tag ohne Spiel automatisch eingesetzt und deine Serie bleibt erhalten. Du erhältst ihn für erledigte Tagesaufgaben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have a streak freeze, it's used automatically on a day you don't play and your streak stays alive. Earn them by finishing daily quests."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tienes un protector de racha, se usa solo el día que no juegas y tu racha no se rompe. Los ganas completando las misiones diarias."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seri koruyucun varsa oynamadığın gün için kendiliğinden kullanılır ve serin bozulmaz. Günlük görevleri bitirerek kazanırsın."
          }
        }
      }
    },
