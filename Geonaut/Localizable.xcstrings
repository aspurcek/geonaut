            "state" : "translated",
            "value" : "Devam etmek için canlarını doldurabilir ya da daha sonra tekrar dönebilirsin."
          }
        }
      }
    },
    "Diğer 3 bölümü bitirince açılan Karışık bölümünün 8 seviyesini tamamladığında bu rozeti kazanırsın." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe die anderen 3 Bereiche ab, um Gemischt freizuschalten, und beende dessen 8 Level für dieses Abzeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish the other 3 sections to unlock Mixed, then complete its 8 levels to earn this badge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina las otras 3 secciones para desbloquear Mixto y completa sus 8 niveles para ganar esta insignia."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer 3 bölümü bitirince açılan Karışık bölümünün 8 seviyesini tamamladığında bu rozeti kazanırsın."
          }
        }
      }
    },
