    "%lld günlük serin kaldığı yerden devam ediyor. Yarın da unutma!" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine %lld-Tage-Serie geht weiter. Vergiss morgen nicht!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %lld-day streak continues. Don't forget tomorrow!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu racha de %lld días continúa. ¡No olvides mañana!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld günlük serin kaldığı yerden devam ediyor. Yarın da unutma!"
