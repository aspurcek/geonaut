    "Düellolar Game Center üzerinden oynanır: davet, sıra ve sonuç arkadaşınla eşleşir. Bağlanmadan düelloya girilemez." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düellolar Game Center üzerinden oynanır: davet, sıra ve sonuç arkadaşınla eşleşir. Bağlanmadan düelloya girilemez."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duels are played through Game Center: invites, turns and results sync with your friend. You need to connect to duel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duelle laufen über Game Center: Einladung, Zug und Ergebnis werden mit deinem Freund abgeglichen. Ohne Verbindung keine Duelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los duelos se juegan con Game Center: invitación, turnos y resultados se sincronizan con tu amigo. Necesitas conectarte para jugar."
          }
        }
      }
    },
    "Düello daveti Game Center bildirimiyle gider. Arkadaşın 3 gün içinde oynamazsa davet düşer." : {
