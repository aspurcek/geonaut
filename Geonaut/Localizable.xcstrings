    "Her doğru cevap 10 puan kazandırır." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede richtige Antwort bringt 10 Punkte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every correct answer earns 10 points."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada respuesta correcta da 10 puntos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her doğru cevap 10 puan kazandırır."
          }
        }
      }
    },
    "Bir seviyeyi bitirince puanların toplamına eklenir. Aynı seviyeyi tekrar oynarsan yalnızca en iyi sonucun sayılır." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du ein Level abschließt, werden die Punkte zu deiner Gesamtsumme addiert. Spielst du ein Level erneut, zählt nur dein bestes Ergebnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you finish a level, its points are added to your total. If you replay a level, only your best result counts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al terminar un nivel, sus puntos se suman a tu total. Si repites un nivel, solo cuenta tu mejor resultado."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir seviyeyi bitirince puanların toplamına eklenir. Aynı seviyeyi tekrar oynarsan yalnızca en iyi sonucun sayılır."
          }
        }
      }
    },
    "Canların bitince 50 puanla devam edebilir, kopan serini 50 puanla canlandırabilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn deine Leben aufgebraucht sind, kannst du für 50 Punkte weiterspielen und eine gerissene Serie für 50 Punkte wiederbeleben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you run out of hearts you can continue for 50 points, and you can revive a broken streak for 50 points."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando te quedes sin vidas puedes continuar por 50 puntos y revivir una racha rota por 50 puntos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canların bitince 50 puanla devam edebilir, kopan serini 50 puanla canlandırabilirsin."
          }
        }
      }
    },
    "Ünvanın, harcadığın puana değil şimdiye kadar kazandığın toplam puana bağlıdır. Puan harcamak ünvanını düşürmez." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Titel hängt von allen Punkten ab, die du je verdient hast, nicht von dem, was du ausgegeben hast. Punkte auszugeben senkt deinen Titel nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your title depends on the total points you have ever earned, not on what you have spent. Spending points never lowers your title."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu título depende del total de puntos que has ganado, no de lo que has gastado. Gastar puntos nunca baja tu título."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ünvanın, harcadığın puana değil şimdiye kadar kazandığın toplam puana bağlıdır. Puan harcamak ünvanını düşürmez."
          }
        }
      }
    },
    "Her gün en az bir seviye bitirince serin bir artar." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe jeden Tag mindestens ein Level ab, und deine Serie wächst um eins."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish at least one level every day and your streak grows by one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina al menos un nivel cada día y tu racha aumenta en uno."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her gün en az bir seviye bitirince serin bir artar."
          }
        }
      }
    },
    "Bir gün hiç oynamazsan seri kopar. 50 puanla kaldığın yerden canlandırabilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Tag aussetzt, reißt deine Serie. Für 50 Punkte kannst du sie dort wiederbeleben, wo du aufgehört hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you skip a day, your streak breaks. You can revive it where you left off for 50 points."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si te saltas un día, tu racha se rompe. Puedes revivirla donde la dejaste por 50 puntos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir gün hiç oynamazsan seri kopar. 50 puanla kaldığın yerden canlandırabilirsin."
          }
        }
      }
    },
    "Serin 7, 14, 21… güne ulaşınca 100 puan hediye kazanırsın." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreicht deine Serie 7, 14, 21… Tage, bekommst du 100 Punkte geschenkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When your streak reaches 7, 14, 21… days you get a 100-point gift."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando tu racha llega a 7, 14, 21… días recibes 100 puntos de regalo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serin 7, 14, 21… güne ulaşınca 100 puan hediye kazanırsın."
          }
        }
      }
    },
    "Profilindeki haftalık takvimde hangi günlerde oynadığını görebilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Wochenkalender in deinem Profil siehst du, an welchen Tagen du gespielt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the weekly calendar on your profile you can see which days you played."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el calendario semanal de tu perfil puedes ver qué días jugaste."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilindeki haftalık takvimde hangi günlerde oynadığını görebilirsin."
          }
        }
      }
    },
    "Bir soruda gördüğün ve cevapladığın her ülke bu sayıya eklenir. Doğru ya da yanlış fark etmez." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Land, das du in einer Frage siehst und beantwortest, wird zu dieser Zahl addiert, richtig oder falsch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every country you see and answer in a question is added to this number, right or wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada país que ves y respondes en una pregunta se suma a este número, aciertes o no."
          }
        },
        "tr" : {
