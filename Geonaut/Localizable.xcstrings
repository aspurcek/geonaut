        }
      }
    },
    "%lld günlük serin sona erdi ama önemli değil. Hadi bugün yeniden başla, yeni bir seri seni bekliyor!" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine %lld-Tage-Serie ist zu Ende, aber das ist nicht schlimm. Fang heute neu an – eine neue Serie wartet!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %lld-day streak ended, but that's okay. Start again today — a new streak awaits!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu racha de %lld días terminó, pero no pasa nada. ¡Empieza hoy de nuevo, te espera una nueva racha!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld günlük serin sona erdi ama önemli değil. Hadi bugün yeniden başla, yeni bir seri seni bekliyor!"
          }
        }
      }
    },
    "%lld günlük serin sona erdi. %lld puan harcayarak serini kaldığın yerden canlandırabilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine %1$lld-Tage-Serie ist zu Ende. Mit %2$lld Punkten kannst du sie wiederbeleben."
