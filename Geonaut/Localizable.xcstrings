    "Geonaut %@ yayında. Oynamaya devam etmek için uygulamayı App Store'dan güncelle; ilerlemen olduğu gibi kalır." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geonaut %@ yayında. Oynamaya devam etmek için uygulamayı App Store'dan güncelle; ilerlemen olduğu gibi kalır."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geonaut %@ is out. Update the app from the App Store to keep playing; your progress stays as it is."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geonaut %@ ist da. Aktualisiere die App im App Store, um weiterzuspielen; dein Fortschritt bleibt erhalten."
