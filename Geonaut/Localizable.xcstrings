    "Her akşam 19.00'da küçük bir hatırlatma gönderelim, serin yarım kalmasın. İstediğin zaman Ayarlar'dan kapatabilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir schicken dir jeden Abend um 19 Uhr eine kleine Erinnerung, damit deine Serie nicht abreißt. Du kannst sie jederzeit in den Einstellungen ausschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let us send a small reminder every evening at 7 PM so your streak doesn't slip away. You can turn it off anytime in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te enviaremos un pequeño recordatorio cada tarde a las 19:00 para que no pierdas tu racha. Puedes desactivarlo cuando quieras en Ajustes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her akşam 19.00'da küçük bir hatırlatma gönderelim, serin yarım kalmasın. İstediğin zaman Ayarlar'dan kapatabilirsin."
          }
        }
      }
    },
