    "Lezzetler kategorisinin 3 turunu da (Tur 1, Tur 2, Tur 3) tamamladığında bu kupayı kazanırsın." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gewinnst diesen Pokal, wenn du alle 3 Runden der Kategorie Spezialitäten (Runde 1, 2, 3) abschließt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You earn this cup when you finish all 3 tours of the Flavors category (Tour 1, Tour 2, Tour 3)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganas esta copa al terminar las 3 rondas de la categoría Sabores (Ronda 1, 2 y 3)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lezzetler kategorisinin 3 turunu da (Tur 1, Tur 2, Tur 3) tamamladığında bu kupayı kazanırsın."
          }
        }
      }
    },
    "Lezzetler kategorisinin 3 turunu da bitirdin! Dünyanın meşhur yemeklerini, tatlılarını ve içeceklerini öğrendin." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast alle 3 Runden bei Spezialitäten geschafft! Du kennst berühmte Gerichte, Desserts und Getränke der Welt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You finished all 3 tours of Flavors! You learned the world's famous dishes, desserts and drinks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Terminaste las 3 rondas de Sabores! Aprendiste los platos, postres y bebidas famosos del mundo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lezzetler kategorisinin 3 turunu da bitirdin! Dünyanın meşhur yemeklerini, tatlılarını ve içeceklerini öğrendin."
          }
        }
      }
    },
    "Lezzetler'de %@ bölümünün 8 seviyesini tamamladığında bu rozeti kazanırsın." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe alle 8 Level von %@ bei Spezialitäten ab, um dieses Abzeichen zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
