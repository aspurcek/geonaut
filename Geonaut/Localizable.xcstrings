          }
        }
      }
    },
    "İlerlemeni, puanlarını ve rozetlerini kaydedebilmemiz için Apple ile giriş yapman gerekiyor." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich mit Apple an, damit wir deinen Fortschritt, deine Punkte und Abzeichen speichern können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in with Apple so we can save your progress, points and badges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con Apple para que podamos guardar tu progreso, puntos e insignias."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlerlemeni, puanlarını ve rozetlerini kaydedebilmemiz için Apple ile giriş yapman gerekiyor."
          }
        }
      }
    },
    "İnceleme ve tanıtım için demo hesabı. Giriş yapınca tüm özellikler açılır." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo-Konto für Prüfung und Präsentation. Nach der Anmeldung sind alle Funktionen freigeschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo account for review and presentation. All features unlock after signing in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta demo para revisión y presentación. Al iniciar sesión se desbloquean todas las funciones."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnceleme ve tanıtım için demo hesabı. Giriş yapınca tüm özellikler açılır."
          }
        }
      }
    },
