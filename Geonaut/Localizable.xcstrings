            "value" : "Finish the other 7 continents to unlock Mixed, then complete its 8 levels to earn this badge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina los otros 7 continentes para desbloquear Mixto y completa sus 8 niveles para ganar esta insignia."
