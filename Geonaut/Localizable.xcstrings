    "Tüm ilerlemen, puanların ve rozetlerin kalıcı olarak silinir." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm ilerlemen, puanların ve rozetlerin kalıcı olarak silinir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All your progress, points and badges will be permanently deleted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein gesamter Fortschritt, deine Punkte und Abzeichen werden dauerhaft gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
