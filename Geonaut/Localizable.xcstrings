          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast Runde %2$lld in %1$@ beendet. Runde %3$lld ist freigeschaltet: gleicher Weg, ganz neue Fragen!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You finished Tour %2$lld in %1$@. Tour %3$lld is unlocked: same path, brand-new questions!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminaste la Ronda %2$lld en %1$@. ¡La Ronda %3$lld está desbloqueada: mismo camino, preguntas nuevas!"
