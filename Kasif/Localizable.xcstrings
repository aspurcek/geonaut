    "Çevrimdışısın — ilerlemen cihazında saklanıyor, bağlantı gelince senkronlanacak.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışısın — ilerlemen cihazında saklanıyor, bağlantı gelince senkronlanacak."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline — your progress is saved on this device and will sync when you're back online."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline – dein Fortschritt wird auf diesem Gerät gespeichert und synchronisiert, sobald du wieder online bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión: tu progreso se guarda en este dispositivo y se sincronizará cuando vuelvas a tener conexión."
          }
        }
      }
    },
