    },
    "O gün oynamadıysan akşam 19:00'da serini hatırlatırız.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O gün oynamadıysan akşam 19:00'da serini hatırlatırız."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you haven't played that day, we'll remind you about your streak at 7 PM."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du an dem Tag nicht gespielt hast, erinnern wir dich um 19:00 Uhr an deine Serie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ese día no has jugado, te recordaremos tu racha a las 19:00."
          }
        }
      }
    },
