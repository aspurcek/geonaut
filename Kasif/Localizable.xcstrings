    "Tüm ilerlemen, puanların ve rozetlerin kalıcı olarak silinir. Bu işlem geri alınamaz.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm ilerlemen, puanların ve rozetlerin kalıcı olarak silinir. Bu işlem geri alınamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your progress, points and badges will be permanently deleted. This cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein gesamter Fortschritt, deine Punkte und Abzeichen werden dauerhaft gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo tu progreso, puntos e insignias se eliminarán permanentemente. Esta acción no se puede deshacer."
