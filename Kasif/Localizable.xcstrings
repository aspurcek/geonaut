    "Bunu kullanmak için giriş yapmalısın": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu kullanmak için giriş yapmalısın"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need to sign in to use this"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Verwenden musst du dich anmelden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes iniciar sesión para usar esto"
          }
        }
      }
    },
    "İlerlemeni, puanlarını ve rozetlerini kaydedebilmemiz için Apple ile giriş yapman gerekiyor.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerlemeni, puanlarını ve rozetlerini kaydedebilmemiz için Apple ile giriş yapman gerekiyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple so we can save your progress, points and badges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit Apple an, damit wir deinen Fortschritt, deine Punkte und Abzeichen speichern können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con Apple para que podamos guardar tu progreso, puntos e insignias."
          }
        }
      }
    },
