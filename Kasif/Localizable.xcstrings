    "Tur %lld": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tur %lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tour %lld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Runde %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ronda %lld"
          }
        }
      }
    },
    "Tur %lld'in kilidini açmak için önce Tur %lld'i bitir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tur %lld'in kilidini açmak için önce Tur %lld'i bitir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish Tour %2$lld first to unlock Tour %1$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe zuerst Runde %2$lld ab, um Runde %1$lld freizuschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina primero la Ronda %2$lld para desbloquear la Ronda %1$lld."
          }
        }
      }
    },
    "%@ · Tur %lld · %lld seviye · %lld soru": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Tur %lld · %lld seviye · %lld soru"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Tour %2$lld · %3$lld levels · %4$lld questions"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Runde %2$lld · %3$lld Level · %4$lld Fragen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Ronda %2$lld · %3$lld niveles · %4$lld preguntas"
          }
        }
      }
    },
    "Tur %lld Tamamlandı!": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tur %lld Tamamlandı!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tour %lld Complete!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Runde %lld geschafft!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Ronda %lld completada!"
          }
        }
      }
    },
    "%@ kategorisinde Tur %lld'i bitirdin. Tur %lld açıldı: aynı yol, yepyeni sorular!": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kategorisinde Tur %lld'i bitirdin. Tur %lld açıldı: aynı yol, yepyeni sorular!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You finished Tour %2$lld in %1$@. Tour %3$lld is unlocked: same path, brand-new questions!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast Runde %2$lld in %1$@ beendet. Runde %3$lld ist freigeschaltet: gleicher Weg, ganz neue Fragen!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminaste la Ronda %2$lld en %1$@. ¡La Ronda %3$lld está desbloqueada: mismo camino, preguntas nuevas!"
          }
        }
      }
    },
    "%@ kategorisinin de kilidi açıldı.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kategorisinin de kilidi açıldı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unlocked too."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ebenfalls freigeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ también está desbloqueado."
          }
        }
      }
    },
    "Bayraklar kategorisinin 3 turunu da (Tur 1, Tur 2, Tur 3) tamamladığında bu kupayı kazanırsın.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayraklar kategorisinin 3 turunu da (Tur 1, Tur 2, Tur 3) tamamladığında bu kupayı kazanırsın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You earn this cup when you finish all 3 tours of the Flags category (Tour 1, Tour 2, Tour 3)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gewinnst diesen Pokal, wenn du alle 3 Runden der Kategorie Flaggen (Runde 1, 2, 3) abschließt."
