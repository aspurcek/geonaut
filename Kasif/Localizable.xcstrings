    "Bayraklar kategorisinin 3 turunu da bitirdin! Dünyadaki tüm kıtaların bayraklarını öğrendin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayraklar kategorisinin 3 turunu da bitirdin! Dünyadaki tüm kıtaların bayraklarını öğrendin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You finished all 3 tours of Flags! You learned the flags of every continent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast alle 3 Runden bei Flaggen geschafft! Du kennst die Flaggen aller Kontinente."
