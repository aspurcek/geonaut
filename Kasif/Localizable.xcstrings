    "Bugün henüz Kaşif'te oynamadın. Serini korumak için bir etap tamamla!": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün henüz Kaşif'te oynamadın. Serini korumak için bir etap tamamla!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't played Kaşif today. Finish a level to keep your streak!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast heute noch nicht Kaşif gespielt. Schließe ein Level ab, um deine Serie zu behalten!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy todavía no has jugado a Kaşif. ¡Completa un nivel para mantener tu racha!"
          }
        }
      }
    },
    "Bugün yeni bir bayrak, ülke ya da lezzet öğrenmeye ne dersin?": {
      "extractionState": "manual",
      "localizations": {
