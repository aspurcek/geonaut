          "stringUnit": {
            "state": "translated",
            "value": "Oyna, öğren, dünyayı keşfet!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play, learn, explore the world!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielen, lernen, die Welt entdecken!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Juega, aprende, explora el mundo!"
          }
        }
      }
    },
