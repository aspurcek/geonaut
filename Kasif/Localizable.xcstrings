    "Lezzetler'deki fotoğraflar Openverse üzerinden, aşağıdaki lisanslarla kullanılmıştır.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lezzetler'deki fotoğraflar Openverse üzerinden, aşağıdaki lisanslarla kullanılmıştır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photos in Flavors come from Openverse and are used under the licenses listed below."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fotos in Spezialitäten stammen von Openverse und werden unter den unten aufgeführten Lizenzen verwendet."
